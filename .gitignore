# competition data (large, license-gated) and derived artifacts
data/raw/*
data/external/*
data/processed/*
data/demo/*
!data/raw/.gitkeep
!data/external/.gitkeep
!data/processed/.gitkeep
!data/demo/.gitkeep

# model artifacts and submissions (keep manifests out of git too; regenerate)
artifacts/*
!artifacts/holdout_round2.json
!artifacts/holdout_round3.json
!artifacts/holdout_round3_followup.json
submissions/*
*.npy
*.pyc
__pycache__/
.pytest_cache/
.venv/
.DS_Store

# note: docs/js/payload.js and docs/js/leaderboard.js ARE tracked (site inputs);
# research/leaderboard_snapshot.json IS tracked (the audited feed history).
